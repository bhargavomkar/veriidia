# Vercel project (Frontend only; this value is public and is embedded in the build)
VERIIDIA_API_BASE_URL=https://your-persistent-backend.example.com

# Persistent backend hosting environment
APP_ENV=production
VERIIDIA_CORS_ORIGINS=https://your-vercel-project.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PROTEAN_AUTOMATED_SUBMISSION_PERMITTED=false
REGISTRATION_SESSION_IDLE_TIMEOUT_SECONDS=900
