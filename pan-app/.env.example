# Local FastAPI / Playwright service
APP_ENV=local
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PROTEAN_AUTOMATED_SUBMISSION_PERMITTED=false
REGISTRATION_SESSION_IDLE_TIMEOUT_SECONDS=900

# Set this only when running the browser service outside the same-origin local gateway.
# Use exact HTTPS origins, separated by commas.
VERIIDIA_CORS_ORIGINS=
