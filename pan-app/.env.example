# Vercel frontend build (public origin, never put credentials in this value)
# Leave blank when the Vercel API functions are used directly.
VERIIDIA_API_BASE_URL=

# Server-side Browserbase secret; never expose this in frontend code.
BROWSERBASE_API_KEY=

# Local FastAPI / Playwright service
APP_ENV=local
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PROTEAN_AUTOMATED_SUBMISSION_PERMITTED=false
REGISTRATION_SESSION_IDLE_TIMEOUT_SECONDS=900

# Set this only when running the browser service outside the same-origin local gateway.
# Use exact HTTPS origins, separated by commas.
VERIIDIA_CORS_ORIGINS=
